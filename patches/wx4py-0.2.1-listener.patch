+    def _reacquire_msg_list(self, session: _ListenSession) -> None:
+        """重建消息列表控件引用(定时强制刷新)。
+
+        补丁:微信重渲染消息列表(如语音转写到达)会使已缓存的 msg_list COM 引用
+        "冻结"——读到的永远是断开前的旧快照,非空但永不更新,读空检测防不住。
+        此方法每 20 秒强制重新定位列表;运行时键没见过、连(类名+文本)也没上报过的
+        条目视为冻结期间漏掉的,补报一次;名字级去重防止重渲染后旧消息重复上报。
+        """
+        session.empty_count = 0
+        session.fail_count = 0
+        session.last_reacquire_at = time.time()
+        try:
+            root = uia.ControlFromHandle(session.hwnd)
+            if root is None:
+                logger.warning(f"刷新消息列表失败(窗口不可用): {session.group}")
+                return
+            msg_list = _find_message_list(root)
+            if msg_list is None:
+                logger.warning(f"刷新消息列表失败(未找到列表控件): {session.group}")
+                return
+            session.root = root
+            session.msg_list = msg_list
+
+            recovered = 0
+            for item in _read_visible_items(msg_list):
+                if item.key in session.seen:
+                    continue
+                session.seen.add(item.key)
+                if item.kind != "message":
+                    continue
+                name_key = (item.class_name, item.name)
+                if name_key in session.emitted_names:
+                    continue
+                if self.ignore_client_sent and self.outgoing_registry.should_ignore(session.group, item.name):
+                    continue
+                session.emitted_names[name_key] = time.time()
+                session.new_count += 1
+                recovered += 1
+                self._handle_message(session, item)
+            cutoff = time.time() - 1800
+            session.emitted_names = {k: t for k, t in session.emitted_names.items() if t > cutoff}
+            logger.info(f"已刷新消息列表引用: {session.group}" +
+                        (f"(补报 {recovered} 条)" if recovered else ""))
+        except Exception as exc:
+            logger.warning(f"刷新消息列表异常: {session.group}: {exc}")
+
